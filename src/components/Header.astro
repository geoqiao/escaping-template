---
import { navigation, site, t, url } from "../lib/site";

interface Props {
  home: boolean;
  section: string;
}

const { home, section } = Astro.props;
const words = site.author.split(/\s+/).filter(Boolean);
const initials = (words.length === 1 ? words[0].slice(0, 2) : (words[0]?.[0] ?? "") + (words.at(-1)?.[0] ?? "")).toUpperCase();
const current = url(section);
---
{home ? (
<header class="home-tools" lang={t.language}>
  <button class="search-toggle" type="button" aria-label={t.search} aria-haspopup="dialog" aria-controls="site-search" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
  <button class="theme-toggle" type="button" aria-label={t.dark_mode} aria-pressed="false" hidden><span aria-hidden="true">◐</span></button>
</header>
) : (
<header class="site-rail" lang={t.language}>
  <a class="identity" href={url("/")} aria-label={site.title + " — " + t.home}>
    {site.avatar ? <img class="identity-avatar" src={site.avatar} alt="" width="64" height="64"> : <span class="identity-mark" aria-hidden="true">{initials}</span>}
    <span class="identity-name">{site.author}</span>
  </a>
  <button class="menu-toggle" type="button" aria-label={t.toggle_menu} aria-controls="navigation-panel" aria-expanded="false">{t.menu} <span aria-hidden="true">＋</span></button>
  <div class="navigation-panel" id="navigation-panel">
  <button class="search-toggle" type="button" aria-label={t.search} aria-haspopup="dialog" aria-controls="site-search" hidden><span aria-hidden="true">⌕</span> {t.search_placeholder} <kbd aria-hidden="true" data-search-shortcut>Ctrl K</kbd></button>
  <nav id="site-navigation" aria-label={t.main_navigation}>
    <p class="eyebrow rail-label">{t.site_index}</p>
    {navigation.map((item) => (
      <a href={item.url} aria-current={item.url === current ? "page" : undefined}>{item.name}{item.url === current && <span class="nav-arrow" aria-hidden="true">↗</span>}</a>
    ))}
  </nav>
  <div class="rail-bottom">
    <button class="theme-toggle" type="button" aria-pressed="false" hidden><span aria-hidden="true">◐</span> {t.dark_mode}</button>
    <p class="rail-note">{t.rail_note}</p>
  </div>
  </div>
</header>
)}

---
import Base from "../../layouts/Base.astro";
import { ideas, t, url } from "../../lib/site";
---
<Base title={t.ideas} path={ideas.length ? "/ideas/" : undefined} section="/ideas/">
<div class="page-heading"><p class="eyebrow">{t.ideas_eyebrow}</p><h1>{t.ideas}<span class="heading-dot" aria-hidden="true">.</span></h1><p>{t.ideas_caption}</p></div>
<div class="idea-list">
  {ideas.map((idea) => <article class="idea-entry"><time datetime={idea.createdDate}>{idea.createdDate}</time><h2><a href={url(idea.path)}>{idea.title} ↗</a></h2><p>{idea.description}</p></article>)}
  {ideas.length === 0 && <section class="empty-state"><span class="empty-mark" aria-hidden="true">…</span><h2>{t.ideas_empty_title}</h2><p>{t.ideas_empty_body}</p><a class="read-link" href={url("/blog/")}>{t.explore_writing} ↗</a></section>}
</div>
</Base>
